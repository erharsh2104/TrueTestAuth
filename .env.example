# Copy this file to .env and fill in your secrets.

# RapidAPI key for Judge0 (https://rapidapi.com/judge0-official/api/judge0-ce).
# Free tier: 50 requests/day. Without this key, only local g++ is used.
JUDGE0_API_KEY=

# Optional: URL of your OWN Piston server, e.g. http://localhost:2000/api/v2/execute
# (the public emkc.org server has rejected all requests since 2026-02-15).
PISTON_URL=

# Optional: override the model directory used by app.py + seed_demo.py
# MODEL_PATH=models/behavioral_auth_model_lstm
